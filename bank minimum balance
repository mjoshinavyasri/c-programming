#include<stdio.h>
int main(){
    int days=0;
    int n,a,b;
    scanf("%d",&n);
    scanf("%d",&a);
    int i=0;
   while (i<n){
       scanf("%d",&b);
       a=a+b;
       if (a<2000) {
           days++;
       }
       i++;
   }
    printf("final balance=%d\n",a);
    printf("low balance days=%d",days);
    return 0;
}
