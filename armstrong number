#include<stdio.h>
#include<string.h>
int main()
{
int n;
    scanf("%d",&n);
int len=0;
int m=n,ori=n;
while(n!=0)
    {
n=n/10;
   len++;
    }
         int sum=0;
while(m!=0)
{
int r=m%10;
    int p=1;
    for(int i=0;i<len;i++)
        {
            p=p*r;
}
    sum=sum+p;
    m=m/10;
}
        if(sum==ori)
        {
            printf("armstrong");
}
else
{
    printf("not armstrong");
}
return 0;
}
