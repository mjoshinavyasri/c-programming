#include<stdio.h>
int main() {
   int accounttype,balance,withdrawl;
    scanf("%d%d%d",&accounttype,&balance,&withdrawl);
    switch (accounttype) {
        case 1:
           if (balance>=withdrawl) {
               printf("transaction successful");
           }
            break;
        case 2:
            if (withdrawl==5000) {
                printf("transaction successful");
            }
            else {
                printf("limit exceeded");
            }
            break;
    }
    return 0;
}
