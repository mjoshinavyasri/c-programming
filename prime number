#include <stdio.h>
int main() {
    int n;
    scanf("%d",&n);
    int count=0;
    for(int i=2;i<=n/2;i++)
    {
        if(n%i==0)
            count++;
        }
        if(count==0)
            printf("%d prime number",n);
            else
            printf("%d not prime number",n);
    return 0;
}
