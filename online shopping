#include<stdio.h>
int main() {
    int deliverymode,charge;
    scanf("%d",&deliverymode);
    switch (deliverymode) {
        case 1:
          charge=40;
            break;
        case 2:
            charge=120;
            break;
        case 3:
            charge=0;
            break;
        default:
            printf("invalid deliverymode");
    }
    printf("%d",charge);
    return 0;
}
