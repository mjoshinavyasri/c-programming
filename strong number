#include<stdio.h>
#include<string.h>
int main()
{
int n;
    scanf("%d",&n);
int m=n;
         int sum=0;
while(n!=0)
{
      int fact=1;
int r=n%10;
      n=n/10;
    for(int i=1;i<=r;i++)
        {
           fact*=i;
}
    sum+=fact;
}
        if(sum==m)
        {
            printf("strong number");
}
else
{
    printf("not strong number");
}
return 0;
}
